//- section
mixin section-mission()
  section.section.section-mission#section-mission
    .wrap__inner
      h2.section-title
        img(src='images/title-mission.svg' alt='活動任務')
        img.leaf-yellow(src='images/title-leaf-yellow.svg' alt='leaf')
        img.leaf-red(src='images/title-leaf-red.svg' alt='leaf')

      h3.section-subtitle 活動期間：即日起 ~ 2024.12.31
        br
        |完成以下3項任務，最高可拿300元

      .section-mission--wrap(data-aos='fade-up' data-aos-duration='1200')
        .section-mission--wrap__card
          .section-mission--wrap__card-content
            h4 首登抽百元
            img(src='images/mission-money.svg' alt='首登抽百元')
            p 2024/12/31前
              br
              |首登網銀會員並完成
              br
              |上方活動登錄
              br
              |抽100元
              span (1,500組)
            a(href='https://mma.sinopac.com/MemberPortal/Member/NextWebLogin.aspx' target='_blank' rel='noopener noreferrer' title='成為永豐網銀會員')
              p 成為永豐網銀會員
              .button-arrow

        .section-mission--wrap__card
          .section-mission--wrap__card-content
            h4 200元送虎利
            img(src='images/mission-tiger.svg' alt='200元送虎利')
            p 2024/12/31前
              br
              |完成任務
              br
              |享200元
              span (5,000組)
            a(href='https://bank.sinopac.com/sinopacBT/webevents/dawho/hot/event-who200/#1' target='_blank' rel='noopener noreferrer' title='前往任務申辦DAWHO數位帳戶')
              p 前往任務
                br
                |申辦DAWHO數位帳戶
              .button-arrow

        .section-mission--wrap__card
          .section-mission--wrap__card-content
            h4 輕便旅行組
            img(src='images/mission-bag.svg' alt='輕便旅行組')
            p 2024/11/30前
              br
              |新卡友開卡30天內首登網銀會員並完成上方活動登錄
              br
              |抽輕便旅行組
              span (限量30組)
            a(href='https://mma.sinopac.com/MemberPortal/Member/NextWebLogin.aspx' target='_blank' rel='noopener noreferrer' title='我有永豐銀行信用卡 成為永豐網銀會員')
              p 我有永豐銀行信用卡
                br
                |成為永豐網銀會員
              .button-arrow
          .mission-seal.noto-900
            img(src='images/mission-seal.svg' alt='卡友加碼抽')
            p 卡友
              br
              |加碼抽

      .section-mission--note(data-aos='fade-up' data-aos-duration='300')
        p *首登網銀會員：可透過以下任一平台(大戶DAWHO APP/永豐行動銀行APP/MMA金融交易網/DACARD APP)登入


    .section-mission--pattern-left
      .section-mission--pattern-left__pic.pink-leaves-sm
        img(src='images/reuse/pink-leaves-sm.svg' alt='')
      .section-mission--pattern-left__pic.pink-leaves-lg
        img(src='images/reuse/pink-leaves-lg.svg' alt='')
      .section-mission--pattern-left__pic.green-leaves
        img(src='images/reuse/green-leaves.svg' alt='')
      .section-mission--pattern-left__pic.yellow-flower
        img(src='images/reuse/yellow-flower.svg' alt='')

    .section-mission--pattern-right
      .section-mission--pattern-right__pic.brown-flower
        img(src='images/reuse/brown-flower.svg' alt='')
      .section-mission--pattern-right__pic.pink-leaves-md
        img(src='images/reuse/pink-leaves-md.svg' alt='')
      .section-mission--pattern-right__pic.brown-leaves
        img(src='images/reuse/brown-leaves.svg' alt='')
      .section-mission--pattern-right__pic.mission-nut
        img(src='images/mission-nut.svg' alt='')
