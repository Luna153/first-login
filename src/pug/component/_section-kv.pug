mixin section-kv()
  section.section.section-kv
    //- .wrap__inner-kv
    .section-kv--main
      h1.section-kv--main__caption
        .section-kv--main__caption-date
          img(src='images/kv-date.svg' alt='即日起～2024/12/31')
        .section-kv--main__caption-title
          img(src='images/kv-title.svg' alt='首登會員')
        .section-kv--main__caption-info
          img(src='images/kv-ticket.svg' alt='最高拿300元，新戶限時再抽好禮')
          //- .section-kv--main__info-shadow
          //-   img(src='images/kv-ticket-shadow.svg' alt='最高拿300元，新戶限時再抽好禮')

      .section-kv--main__person.section-kv--main__person-man
        img(src='images/kv-man.svg' alt='')
      .section-kv--main__person.section-kv--main__person-woman
        img(src='images/kv-woman.svg' alt='')

    //- 大型裝飾-左
    .section-kv--bg-left
      .section-kv--bg-left__pic
        img.pc(src='images/kv-bg.svg' alt='大版背景')
        img.mob(src='images/kv-bg-mob.svg' alt='小版背景')
      .section-kv--bg-left__pic.kv-mount-left1
        img(src='images/kv-mount-left1.svg' alt='山')
      .section-kv--bg-left__pic.kv-mount-left2
        img(src='images/kv-mount-left2.svg' alt='山')
      .section-kv--bg-left__pic.kv-tree-left
        img.pc(src='images/kv-tree-left.svg' alt='大版樹')
        img.mob(src='images/kv-tree-left-mob.svg' alt='小版樹')
      .section-kv--bg-left__pic
        img(src='images/kv-bigLeaf.svg' alt='葉子')
    //- 大型裝飾-右
    .section-kv--bg-right
      .section-kv--bg-right__pic.kv-mount-right1
        img(src='images/kv-mount-right1.svg' alt='山')
      .section-kv--bg-right__pic.kv-mount-right2
        img(src='images/kv-mount-right2.svg' alt='山')
      .section-kv--bg-right__pic.kv-tree-right
        img.pc(src='images/kv-tree-right.svg' alt='大版樹')
        img.mob(src='images/kv-tree-right-mob.svg' alt='小版樹')



    .section-kv--pattern-left
      .section-kv--pattern-left__pic.kv-decorate-left1
        img(src='images/kv-decorate-left1.svg' alt='中型楓葉')
      .section-kv--pattern-left__pic.kv-decorate-left2
        img(src='images/kv-decorate-left2.svg' alt='錢幣一')
      .section-kv--pattern-left__pic.kv-decorate-left3
        img(src='images/kv-decorate-left3.svg' alt='小型楓葉')
      .section-kv--pattern-left__pic.kv-decorate-left4
        img(src='images/kv-decorate-left4.svg' alt='綠色葉子')
      .section-kv--pattern-left__pic.kv-decorate-left5
        img(src='images/kv-decorate-left5.svg' alt='大型楓葉')
      .section-kv--pattern-left__pic.kv-decorate-left6
        img(src='images/kv-decorate-left6.svg' alt='錢幣二')
      .section-kv--pattern-left__pic.kv-decorate-left7
        img(src='images/kv-decorate-left7.svg' alt='橘色葉子')
      .section-kv--pattern-left__pic.kv-decorate-left8
        img(src='images/kv-decorate-left8.svg' alt='最大型楓葉')

    .section-kv--pattern-right
      .section-kv--pattern-right__pic.kv-decorate-right1
        img(src='images/kv-decorate-right1.svg' alt='淡橘色葉子')
      .section-kv--pattern-right__pic.kv-decorate-right2
        img(src='images/kv-decorate-right2.svg' alt='錢幣一')
      .section-kv--pattern-right__pic.kv-decorate-right3
        img(src='images/kv-decorate-right3.svg' alt='錢幣二')
      .section-kv--pattern-right__pic.kv-decorate-right4
        img(src='images/kv-decorate-right4.svg' alt='蜻蜓')
      .section-kv--pattern-right__pic.kv-decorate-right5
        img(src='images/kv-decorate-right5.svg' alt='綠色葉子')
      .section-kv--pattern-right__pic.kv-decorate-right6
        img(src='images/kv-decorate-right6.svg' alt='大型楓葉')
      .section-kv--pattern-right__pic.kv-decorate-right7
        img(src='images/kv-decorate-right7.svg' alt='小型楓葉')
      .section-kv--pattern-right__pic.kv-decorate-right8
        img(src='images/kv-decorate-right8.svg' alt='中型楓葉')

    .section-kv--scrollDown.roboto
      p SCROLL DOWN
      img(src='images/kv-scrollDown.svg' alt='scrollDown')