//- section
mixin section-way()
  section.section.section-way#section-way
    //- 最大寬度1300
    .wrap__inner
      h2.section-title(data-aos='fade-up' data-aos-duration='1200')
        img(src='images/title-way.svg' alt='活動辦法')
        img.leaf-yellow(src='images/title-leaf-yellow.svg' alt='leaf')
        img.leaf-red(src='images/title-leaf-red.svg' alt='leaf')

      .section-way--box.noto-500(data-aos='fade-up' data-aos-duration='1400')
        .btn-round.l-open(href='#LimitedTask' title='永豐VIP限定 完成任務最高拿300元')
          span 永豐VIP限定
          span 完成任務最高拿300元
          .arrow
        .btn-round.l-open(href='#CompletedTask' title='卡友完成任務抽 輕便旅行組')
          span 卡友完成任務抽
          span 輕便旅行組
          .arrow

    //- .section-way--bg