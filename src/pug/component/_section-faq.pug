mixin faq-toggle(datas, cat)
  each data in datas
    if data.cat == cat
      .toggle
        h3.toggle__trigger!=data.title
          i.toggle__trigger-icon.toggle__trigger-icon.material-icons-outlined(data-icon='expand_circle_down')
        h4.toggle__content!=data.content

mixin section-faq()
  section.section.section-faq#section-faq

    //- 背景插圖
    .section-faq--bg-left
      .section-faq--bg-left__pic.section-faq--bg-left_1
        img(src='images/reuse/green-leaves.svg' alt='leaf')
      .section-faq--bg-left__pic.section-faq--bg-left_2
        img(src='images/reuse/pink-leaves-lg.svg' alt='leaf')

    .section-faq--bg-right
      .section-faq--bg-right__pic.section-faq--bg-right_1
        img(src='images/reuse/green-leaves.svg' alt='leaf')
      .section-faq--bg-right__pic.section-faq--bg-right_2
        img(src='images/reuse/yellow-flower.svg' alt='leaf')

    .wrap__inner
      .center(data-aos='fade-up' data-aos-duration='1200')
        h2.section-title
          img(src='images/title-faq.svg' alt='活動Q&A')
          img.leaf-yellow(src='images/title-leaf-yellow.svg' alt='leaf')
          img.leaf-red(src='images/title-leaf-red.svg' alt='leaf')

      .section-faq--box(data-aos='fade-up' data-aos-duration='1600')
        +faq-toggle(faq_data, '活動Q&A')
