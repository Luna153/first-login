//- section
mixin section-download()
  section.section.section-download#section-download
    //- 背景插圖
    .section-download--bg-left
      .section-download--bg-left__pic.section-download--bg-left_1
        img(src='images/download-decorate-left1.svg' alt='leaf')
      .section-download--bg-left__pic.section-download--bg-left_2
        img(src='images/download-decorate-left2.svg' alt='leaf')
      .section-download--bg-left__pic.section-download--bg-left_3
        img(src='images/download-decorate-leftGroup.svg' alt='leaf')
      .section-download--bg-left__pic.section-download--bg-left_4
        img(src='images/download-decorate-left3.svg' alt='leaf')
      .section-download--bg-left__pic.section-download--bg-left_5
        img(src='images/reuse/green-leaves-md.svg' alt='leaf')

    .section-download--bg-right
      .section-download--bg-right__pic.section-download--bg-right_1
        img(src='images/reuse/green-leaves-md.svg' alt='leaf')
      .section-download--bg-right__pic.section-download--bg-right_2
        img(src='images/download-decorate-right1.svg' alt='leaf')
      .section-download--bg-right__pic.section-download--bg-right_3
        img(src='images/download-decorate-right2.svg' alt='leaf')
      .section-download--bg-right__pic.section-download--bg-right_4
        img(src='images/download-decorate-rightGroup.svg' alt='leaf')

    //- 最大寬度1300
    .wrap__inner
      h2.section-title(data-aos='fade-up' data-aos-duration='1200')
        img(src='images/title-download.svg' alt='立即下載')
        img.leaf-yellow(src='images/title-leaf-yellow.svg' alt='leaf')
        img.leaf-red(src='images/title-leaf-red.svg' alt='leaf')


      .section-download--box

        .section-download--card(data-aos='fade-up' data-aos-duration='1500')
          .section-download--card__title.noto-700 行動銀行APP
          .section-download--card__link
            .section-download--card__qrcode
              img(src='images/download-qrocde--mobile.svg' alt='行動銀行APP')
            .section-download--card__app
              .section-download--card__android
                a(href='https://dmp.sinopac.com/DMP_SA/r/BB' target='_blank' title='行動銀行APP下載點' rel='noopener noreferrer')
                  img(src='images/download-android.svg' alt='行動銀行APP')
              .section-download--card__ios
                a(href='https://dmp.sinopac.com/DMP_SA/r/BB' target='_blank' title='行動銀行APP下載點' rel='noopener noreferrer')
                  img(src='images/download-ios.svg' alt='行動銀行APP')

        .section-download--card(data-aos='fade-up' data-aos-duration='1800')
          .section-download--card__title.noto-700 DAWHO APP
          .section-download--card__link
            .section-download--card__qrcode
              img(src='images/download-qrocde--dawho.svg' alt='DAWHO APP')
            .section-download--card__app
              .section-download--card__android
                a(href='https://dmp.sinopac.com/DMP_SA/r/AB' target='_blank' title='DAWHO APP下載點' rel='noopener noreferrer')
                  img(src='images/download-android.svg' alt='DAWHO APP')
              .section-download--card__ios
                a(href='https://dmp.sinopac.com/DMP_SA/r/AB' target='_blank' title='DAWHO APP下載點' rel='noopener noreferrer')
                  img(src='images/download-ios.svg' alt='DAWHO APP')

        .section-download--card(data-aos='fade-up' data-aos-duration='2100')
          .section-download--card__title.noto-700 大咖APP
          .section-download--card__link
            .section-download--card__qrcode
              img(src='images/download-qrocde--dacard.svg' alt='大咖APP')
            .section-download--card__app
              .section-download--card__android
                a(href='https://dmp.sinopac.com/DMP_SA/r/L' target='_blank' title='大咖APP下載點' rel='noopener noreferrer')
                  img(src='images/download-android.svg' alt='大咖APP')
              .section-download--card__ios
                a(href='https://dmp.sinopac.com/DMP_SA/r/L' target='_blank' title='大咖APP下載點' rel='noopener noreferrer')
                  img(src='images/download-ios.svg' alt='大咖APP')


